# 配置示例 · 复制为 .env 并填入真实值（.env 已加入 .gitignore，不会被提交）

# ==================== Claude API 鉴权（二选一）====================

# 方式 1：官方直连
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# 方式 2：公司网关（讯飞 one.iflytek.com）
# ANTHROPIC_AUTH_TOKEN=sk-xxxxxxxxxxxxxxxx
# ANTHROPIC_BASE_URL=https://one.iflytek.com/api/llm/console/chat

# ==================== 模型与运行模式 ====================

# 默认用最强的 Opus 4.8；成本敏感时可换 Haiku
ANTHROPIC_MODEL=claude-opus-4-8

# mock 模式：不连真机、不调 LLM，用样本数据跑（单测/演示用）
# PLATFORM_MOCK=1

# ==================== 设备连接 ====================

# 无线 adb：把被测设备的 IP 填在这里
# DEVICE_ADDR=10.7.187.152:5555

# logcat 抓取行数上限
# LOGCAT_LINES=800

# 台灯插件跑 iperf3 时用的 server IP（电脑端 iperf3 -s）
# IPERF3_SERVER=192.168.211.2
